{
  "name": "@paneljs/example-typeorm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch index.ts",
    "start": "node --env-file=.env --import tsx index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:seed": "node --env-file=.env --import tsx seed.ts",
    "e2e:seed": "node --import tsx e2eSeed.ts",
    "admin:createsuperuser": "node --env-file=.env --import tsx ../../../packages/paneljs/src/cli.ts createsuperuser --config ./paneljs.config.ts",
    "lint": "echo \"example-typeorm: no lint yet\""
  },
  "dependencies": {
    "@paneljs/express": "workspace:*",
    "paneljs": "workspace:*",
    "@paneljs/typeorm": "workspace:*",
    "express": "^5.0.0",
    "pg": "^8.16.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "5.9.2"
  }
}
