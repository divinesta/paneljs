{
  "name": "@paneljs/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"@paneljs/testkit: no lint yet\"",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "paneljs": "workspace:*",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "5.9.2"
  }
}
