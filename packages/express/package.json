{
  "name": "@paneljs/express",
  "version": "0.1.1",
  "description": "Express adapter for PanelJS. Mounts the admin UI and API on an Express app.",
  "license": "MIT",
  "type": "module",
  "author": "Divinesta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divinesta/paneljs.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/divinesta/paneljs/issues"
  },
  "homepage": "https:paneljs.com",
  "keywords": [
    "paneljs",
    "express",
    "admin",
    "admin-panel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "echo \"@paneljs/express: no lint yet\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@paneljs/paneljs": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "express": "^5.0.0",
    "typescript": "5.9.2"
  }
}
