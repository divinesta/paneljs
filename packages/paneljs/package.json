{
  "name": "paneljs",
  "version": "0.2.2",
  "description": "Django-style, schema-driven Prisma admin panel for Express and Node.js applications.",
  "license": "MIT",
  "type": "module",
  "author": "Divinesta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divinesta/paneljs.git",
    "directory": "packages/paneljs"
  },
  "bugs": {
    "url": "https://github.com/divinesta/paneljs/issues"
  },
  "homepage": "https://github.com/divinesta/paneljs",
  "keywords": [
    "prisma-admin",
    "prisma-admin-panel",
    "express",
    "prisma",
    "express-admin",
    "nodejs-admin",
    "django-admin-alternative",
    "typescript-admin",
    "schema-driven",
    "crud"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --dir ui build && tsc -p tsconfig.build.json",
    "dev": "pnpm --dir ui dev",
    "lint": "echo \"paneljs: no lint yet\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "5.9.2"
  }
}
