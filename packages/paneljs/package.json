{
  "name": "paneljs",
  "version": "0.1.0",
  "description": "Schema-driven admin panel core. Register models, serve a guarded operations UI.",
  "license": "MIT",
  "type": "module",
  "author": "Divinesta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divinesta/paneljs.git",
    "directory": "packages/paneljs"
  },
  "bugs": {
    "url": "https://github.com/divinesta/paneljs/issues"
  },
  "homepage": "https://github.com/divinesta/paneljs",
  "keywords": [
    "admin",
    "admin-panel",
    "express",
    "prisma",
    "crud"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --dir ui build && tsc -p tsconfig.build.json",
    "dev": "pnpm --dir ui dev",
    "lint": "echo \"paneljs: no lint yet\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "5.9.2"
  }
}
