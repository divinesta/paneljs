{
  "name": "@paneljs/prisma",
  "version": "0.3.0",
  "description": "Prisma adapter for PanelJS, a Django-style admin panel for Express and Node.js applications.",
  "license": "MIT",
  "type": "module",
  "author": "Divinesta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divinesta/paneljs.git",
    "directory": "packages/prisma"
  },
  "bugs": {
    "url": "https://github.com/divinesta/paneljs/issues"
  },
  "homepage": "https://paneljs.com",
  "keywords": [
    "paneljs",
    "prisma",
    "prisma-admin",
    "prisma-admin-panel",
    "prisma-express-admin",
    "express-admin",
    "django-admin-alternative",
    "dmmf"
  ],
  "bin": {
    "paneljs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fixture:generate": "prisma generate --config test/fixture/prisma.config.ts",
    "fixture:validate": "prisma validate --config test/fixture/prisma.config.ts",
    "lint": "echo \"@paneljs/prisma: no lint yet\"",
    "check-types": "pnpm run fixture:generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:unit": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:integration": "pnpm run fixture:generate && vitest run test/integration --testTimeout 30000 --hookTimeout 120000",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@prisma/dmmf": "~7.5.0",
    "@prisma/internals": "~7.5.0",
    "paneljs": "workspace:^"
  },
  "peerDependencies": {
    "@prisma/client": "~7.5.0",
    "prisma": "~7.5.0"
  },
  "devDependencies": {
    "@paneljs/testkit": "workspace:*",
    "@prisma/adapter-pg": "~7.5.0",
    "@prisma/client": "~7.5.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "prisma": "~7.5.0",
    "typescript": "5.9.2"
  }
}
