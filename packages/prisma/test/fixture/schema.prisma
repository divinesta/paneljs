generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum ContractRole {
  USER
  ADMIN
}

enum ContractAdminRole {
  ADMIN
  SUPER_ADMIN
}

model Tenant {
  id                String           @id
  name              String           @unique
  users             User[]
  posts             Post[]
  cascadeChildren   CascadeChild[]
  nullableChildren  NullableChild[]
  protectedChildren ProtectedChild[]
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  fullName  String
  role      ContractRole @default(USER)
  isActive  Boolean      @default(true)
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts     Post[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([tenantId])
}

model CascadeChild {
  id       String @id @default(uuid())
  label    String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NullableChild {
  id       String  @id @default(uuid())
  label    String
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model ProtectedChild {
  id       String @id @default(uuid())
  label    String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model ExpressAdminUser {
  id           String                @id @default(uuid())
  email        String?               @unique
  username     String?               @unique
  passwordHash String
  role         ContractAdminRole     @default(ADMIN)
  isActive     Boolean               @default(true)
  tenantId     String?
  sessions     ExpressAdminSession[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ExpressAdminSession {
  id        String           @id @default(uuid())
  tokenHash String           @unique
  userId    String
  user      ExpressAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([expiresAt])
}
